# Copy to .env for local development. Never commit the real .env.

# Development: True. Production: False (the default when unset).
DEBUG=True

# Required when DEBUG is False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Comma separated. On Azure App Service the site host is added automatically.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# PostgreSQL (leave DB_HOST empty to use SQLite). The AZURE_POSTGRESQL_*
# names are also accepted.
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=5432
DB_SSLMODE=prefer

# Accounts
ALLOW_REGISTRATION=True
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Business details printed on receipts and invoices
BUSINESS_NAME=InventoryMS
BUSINESS_ADDRESS=Tom Mboya Street, Tudor
BUSINESS_PO_BOX=P.O. Box 90420-80100, Mombasa
BUSINESS_PHONE=+254 700 000000
BUSINESS_EMAIL=
BUSINESS_TAX_PIN=
BUSINESS_CURRENCY=Ksh
TIME_ZONE=Africa/Nairobi

# Loyalty: 1 point per LOYALTY_EARN_PER spent; 1 point = LOYALTY_POINT_VALUE off
LOYALTY_ENABLED=True
LOYALTY_EARN_PER=100
LOYALTY_POINT_VALUE=1.00
LOYALTY_MIN_REDEEM=0
